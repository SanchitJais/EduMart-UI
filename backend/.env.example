# EduMart Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database (MongoDB — uncomment when ready)
# MONGODB_URI=mongodb://localhost:27017/edumart
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/edumart

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Email (for order confirmations — optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password

# Razorpay (for payments — optional)
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_SECRET=xxxx
