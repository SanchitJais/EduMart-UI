# Backend env config
# Copy to .env and set your values

# Server setup
PORT=5000
NODE_ENV=development

# Frontend CORS URL
CLIENT_URL=http://localhost:5173

# JWT secret key
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database (optional MongoDB)
# MONGODB_URI=mongodb://localhost:27017/edumart

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Resend API key for emails
RESEND_API_KEY=
EMAIL_FROM=EduMart <onboarding@resend.dev>

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Razorpay payments (optional)
# RAZORPAY_KEY_ID=
# RAZORPAY_SECRET=
