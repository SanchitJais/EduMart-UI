# EduMart Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database (MongoDB — uncomment when ready)
# MONGODB_URI=mongodb://localhost:27017/edumart
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/edumart
# Until then, auth data lives in backend/data/db.json (auto-created).

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Email (for order confirmations — optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password

# Resend — transactional email for account verification
# Get a key at https://resend.com/api-keys (free tier available).
# Without a key set, verification links are printed to the server
# console instead of emailed, so the flow still works for local dev.
RESEND_API_KEY=
# Must be onboarding@resend.dev (no domain setup needed) or an
# address on a domain you've verified with Resend.
EMAIL_FROM=EduMart <onboarding@resend.dev>

# Google Sign-In
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials — add both
# http://localhost:5173 and your production URL under
# "Authorized JavaScript origins". Use the same value here and in
# the frontend's VITE_GOOGLE_CLIENT_ID (see .env.example at repo root).
GOOGLE_CLIENT_ID=

# Razorpay (for payments — optional)
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_SECRET=xxxx
